{
  "name": "dreamatron-timeline",
  "main": "cloudflare/timeline-worker.mjs",
  "account_id": "3f41ed552aeac05aa16fad602ef306fc",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "dreamatron.ai/timeline*", "zone_name": "dreamatron.ai"},
    {"pattern": "www.dreamatron.ai/timeline*", "zone_name": "dreamatron.ai"}
  ],
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "head_sampling_rate": 1, "invocation_logs": true},
    "traces": {"enabled": true, "head_sampling_rate": 0.01}
  }
}
